	private boolean isCombinationValid(int firstButton, int secondButton) {
		for (int[] combination : validCombinations) {
			int btn1 = combination[0];
			int btn2 = combination[1];

			if ((firstButton == btn1 && secondButton == btn2) ||
					(firstButton == btn2 && secondButton == btn1)) {
				return true;
			}
		}
		return false;
	}	

	private void checkAnswers() {
		int correctPairs = 0;
		for (ColorPair selectedPair : selectedPairs) {
			boolean isCorrect = isCombinationValid(selectedPair.firstButton, selectedPair.secondButton);

			if (isCorrect) {
				correctPairs++;
				System.out.println("correctPairs "+correctPairs);
				highlightButtonAsCorrect(selectedPair.firstButton);
				highlightButtonAsCorrect(selectedPair.secondButton);
			} else {
				highlightButtonAsWrong(selectedPair.firstButton);
				highlightButtonAsWrong(selectedPair.secondButton);
			}
		}
		
		if (correctPairs == qShow) {
			count++;
		}
		
	}

	private void updateButtonAvailability() {
		enableAllButtons();

		// Блокируем уже использованные кнопки
		for (int buttonId : usedButtons) {
			JButton button = getButtonById(buttonId);
			if (button != null) {
				button.setEnabled(false);
			}
		}

		System.out.println("currentFirstButton= "+currentFirstButton);		
		
		if (currentFirstButton != -1) {
			// Если выбрана первая кнопка, блокируем остальные кнопки из той же группы
			if (currentFirstButton <= 5) {
				// Выбрана кнопка 1-5, блокируем остальные из 1-5
				for (int i = 1; i <= 5; i++) {
					if (i != currentFirstButton && !usedButtons.contains(i)) {
						JButton button = getButtonById(i);
						if (button != null) {
							button.setEnabled(false);
							System.out.println(button.getText());
						}
					}
				}
			} else {
				// Выбрана кнопка 6-10, блокируем остальные из 6-10
				for (int i = 6; i <= 10; i++) {
					if (i != currentFirstButton && !usedButtons.contains(i)) {
						JButton button = getButtonById(i);
						if (button != null) {
							button.setEnabled(false);
						}
					}
				}
			}
		}
	}


	private void handleButtonSelection(int buttonId, int pairsLeft) {
		// Максимально можно выбрать 5 пар (10 кнопок / 2 = 5 пар)
		
		
		System.out.println("pairCounter = "+ pairCounter);
		System.out.println("currentColor = "+ currentColor);
		System.out.println("buttonId= "+ buttonId);
		System.out.println("currentFirstButton = "+currentFirstButton+" before");
		System.out.println("usedButtons= "+usedButtons);
		System.out.println("selectedPairs= "+selectedPairs);
		System.out.println();
		System.out.println();
		
		
		if (pairCounter >= pairsLeft) return;

		if (usedButtons.contains(buttonId)) {
			return;
		}

		currentColor = colors[pairCounter];

		if (currentFirstButton == -1) {
			// Первая кнопка в паре
			currentFirstButton = buttonId;
			highlightButton(buttonId, currentColor, true);
			updateButtonAvailability();
		} else {
			// Вторая кнопка в паре
			if (currentFirstButton == buttonId) return;

			if (usedButtons.contains(buttonId)) {
				return;
			}

			// Проверяем, что вторая кнопка из противоположной группы
			boolean isValidPair = false;
			if (currentFirstButton <= 5 && buttonId >= 6) {
				isValidPair = true; // Первая 1-5, вторая 6-10
			} else if (currentFirstButton >= 6 && buttonId <= 5) {
				isValidPair = true; // Первая 6-10, вторая 1-5
			}

			if (!isValidPair) {
				// Неправильная комбинация, игнорируем
				return;
			}

			selectedPairs.add(new ColorPair(currentFirstButton, buttonId, currentColor));

			usedButtons.add(currentFirstButton);
			usedButtons.add(buttonId);

			highlightButton(currentFirstButton, currentColor, false);
			highlightButton(buttonId, currentColor, false);

			pairCounter++;
			currentFirstButton = -1;

			updateButtonAvailability();


			if (pairCounter == pairsLeft) {
				btnNewButton.setEnabled(true);

			}
		}
	}

	private void cancelLastAction() {


		if (currentFirstButton != -1) {
			currentFirstButton = -1;
		} else if (!selectedPairs.isEmpty()) {
			ColorPair lastPair = selectedPairs.remove(selectedPairs.size() - 1);

			usedButtons.remove(Integer.valueOf(lastPair.firstButton));
			usedButtons.remove(Integer.valueOf(lastPair.secondButton));

			pairCounter--;

			if (pairCounter >= 0) {
				currentColor = colors[pairCounter];
			}
		}

		updateButtonAvailability();


	}


	private void highlightButton(int buttonId, String color, boolean isFirst) {
		Color color1 = null;
		JButton button = getButtonById(buttonId);
		if (button == null) return;

		String style = String.format(
				"-fx-background-color: %s; -fx-text-fill: white; -fx-background-radius: 15; -fx-border-radius: 15;",
				color
				);

		if (isFirst) {
			style += " -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);";
		}
		switch (color) {
		case "blue": 
			color1 = Color.blue;
			break;
		case "pink": 
			color1 = Color.pink;
			break;
		case "yellow": 
			color1 = Color.yellow;
			break;
		case "orange": 
			color1 = Color.orange;
			break;
		case "cyan": 
			color1 = Color.cyan;
			break;
		}
		
		button.setBackground(color1);



	}







